/target
# Dropbox forks the build dir on sync collisions ('target (Selective Sync
# Conflict 2)'), which /target does not match — thousands of build
# artifacts otherwise land in `git add -A`.
/target (Selective Sync Conflict*)
/**/target (Selective Sync Conflict*)
# dist/ holds generated release artifacts (ignored) — but dist/systemd/
# unit templates are tracked source. Git needs the parent un-ignored for the
# negation to work, hence the three-line pattern.
/dist/*
!/dist/systemd
!/dist/install.sh
**/*.rs.bk
*.swp
*.swo
.env
*.db
*.db-shm
*.db-wal
.DS_Store

# Agent harness / working artifacts — never committed
.clawpatch/
_internal/
worktrees/
.hermes/
/node_modules/

# Out-of-scope subprojects (tracked separately or deferred)
apps/

# Stray scratch files
*.tif
.worktrees/
