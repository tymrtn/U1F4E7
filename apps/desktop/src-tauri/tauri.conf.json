{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Envelope",
  "version": "1.3.26",
  "identifier": "dev.envelope.email.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Envelope",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/envelope"
    ],
    "category": "Productivity",
    "shortDescription": "Local dashboard shell for Envelope",
    "longDescription": "Envelope desktop launches a local envelope server and opens the dashboard, with connection health and diagnostics."
  }
}
